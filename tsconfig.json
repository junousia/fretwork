{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "node"
    ],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "skipLibCheck": true
  },
  "include": [
    "site/**/*.js",
    "tools/**/*.mjs",
    "test/**/*.mjs"
  ],
  "exclude": [
    "node_modules",
    "test/golden",
    "site/sw.js"
  ]
}
